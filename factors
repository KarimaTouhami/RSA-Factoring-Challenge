#!/usr/bin/env python3
""" Factor numbers """
from sys import argv
from math import isqrt


def open_read_file(file_name):
    """ read from file add to array """
    with open(file_name, "r", encoding="utf-8") as file:
        lines = file.readlines()
    number_to_factor = []
    for line in lines:
        if line.strip():
            number_to_factor.append(int(line))
    return number_to_factor


def smallest_factor(n):
    """ smallest divisor of n, or n when n is prime """
    if n % 2 == 0:
        return 2
    for i in range(3, isqrt(n) + 1, 2):
        if n % i == 0:
            return i
    return n


def find_and_times(n):
    """ factor each n given """
    p = smallest_factor(n)
    if p == n:
        print("{}={}*1".format(n, n))
    else:
        print("{}={}*{}".format(n, n // p, p))


def fac_list(ls):
    """ factor each num in ls """
    for i in ls:
        find_and_times(i)


if len(argv) == 2:
    fac_list(open_read_file(argv[1]))
